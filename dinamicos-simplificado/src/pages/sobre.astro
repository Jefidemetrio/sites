---
// Sobre - Dinâmicos
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout 
  title="Sobre a Dinâmicos" 
  description="Conheça a equipa por trás da Dinâmicos. Presença digital inteligente para empresas portuguesas."
>
  <!-- Header -->
  <section class="section text-center">
    <div class="container">
      <h1 class="section-title">Sobre a Dinâmicos</h1>
      <p class="text-lg text-medium max-w-2xl mx-auto">
            Somos uma agência especializada em criar presença digital profissional para PMEs tecnológicas em Portugal.
      </p>
    </div>
  </section>

  <!-- Mission/Vision -->
  <section class="section bg-light">
    <div class="container grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2>Os nossos valores</h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-xl font-semibold mb-2">Simplicidade</h3>
            <p>Criamos soluções limpas, sem complexidade desnecessária.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Inovação</h3>
            <p>Usamos tecnologia de ponta para resultados reais.</p>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Resultados</h3>
            <p>Foco mensurável em conversão e visibilidade.</p>
          </div>
        </div>
      </div>
      <div>
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <div class="text-3xl font-bold text-primary">5+</div>
            <p class="text-sm text-medium">anos de experiência</p>
          </div>
          <div class="border-l border-r border-light">
            <div class="text-3xl font-bold text-primary">50+</div>
            <p class="text-sm text-medium">clientes satisfeitos</p>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">15+</div>
            <p class="text-sm text-medium">cases de sucesso</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">A equipa</h2>
      <p class="text-center text-medium mb-12">Profissionais dedicados à sua visão digital</p>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Team Member 1 -->
        <div class="text-center">
          <div class="w-32 h-32 bg-light rounded-full mx-auto mb-4"></div>
          <h3 class="font-semibold mb-1">Nome da Pessoa</h3>
          <p class="text-primary font-medium">Fundador & CEO</p>
        </div>
        
        <!-- Team Member 2 -->
        <div class="text-center">
          <div class="w-32 h-32 bg-light rounded-full mx-auto mb-4"></div>
          <h3 class="font-semibold mb-1">Nome da Pessoa</h3>
          <p class="text-primary font-medium">Especialista SEO</p>
        </div>
        
        <!-- Team Member 3 -->
        <div class="text-center">
          <div class="w-32 h-32 bg-light rounded-full mx-auto mb-4"></div>
          <h3 class="font-semibold mb-1">Nome da Pessoa</h3>
          <p class="text-primary font-medium">Desenvolvedor Frontend</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.section {
  padding: 4rem 0;
}

.section-title {
  font-size: clamp(2rem, 4vw, 2.5rem);
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  margin-bottom: 2rem;
}

.card {
  background: white;
  border: 1px solid #E5E5EA;
  border-radius: 12px;
  padding: 2rem;
  transition: all 0.2s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}
</style>