---
import Layout from '../../layouts/Layout.astro';
import { getAllBlogPosts } from '../../lib/blog';

export const prerender = true;

const posts = getAllBlogPosts().sort((a, b) => b.published.getTime() - a.published.getTime());
---

<Layout 
  title="Artigos e Insights" 
  description="Artigos sobre SEO, presença digital e estratégias B2B para PMEs portuguesas."
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">Artigos & Insights</h1>
      <p class="text-center text-medium mb-12">
        Estratégias, dicas e inspirações para transformar a sua presença digital.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.slice(0, 6).map((post) => (
          <article class="card">
            <img 
              src={post.image || '/images/blog-placeholder.webp'} 
              alt={post.title}
              class="w-full h-48 object-cover rounded-t-lg"
              loading="lazy"
            />
            <div class="p-6">
              <div class="text-sm text-medium mb-2">{post.published.toLocaleDateString('pt-PT')}</div>
              <h2 class="text-xl font-semibold mb-3 line-clamp-2">
                <a href={`/blog/${post.slug}`} class="hover:text-primary transition-colors">
                  {post.title}
                </a>
              </h2>
              <p class="text-medium mb-4 line-clamp-3">{post.description}</p>
              <a href={`/blog/${post.slug}`} class="text-primary hover:underline font-medium">
                Ler artigo →
              </a>
            </div>
          </article>
        ))}
      </div>

      {posts.length > 6 && (
        <div class="text-center mt-12">
          <a href="/blog" class="btn btn-primary">
            Ver todos os artigos
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Lead Magnet -->
  <section class="section bg-light">
    <div class="container text-center max-w-2xl">
      <h2 class="section-title mb-6">Baixe nosso guia gratuito</h2>
      <p class="text-lg text-medium mb-8">
        Checklist de 10 erros SEO que matam sites B2B em Portugal
      </p>
      <form 
        action="https://api.formsubmit.co/youremail@example.com" 
        method="POST"
        class="bg-white p-8 rounded-xl shadow-md max-w-sm mx-auto"
      >
        <input 
          type="email" 
          name="email" 
          placeholder="O seu email" 
          required
          class="input w-full mb-4"
        />
        <button type="submit" class="btn btn-primary w-full">
          Baixar checklist
        </button>
      </form>
    </div>
  </section>
</Layout>

<style>
.card {
  background: white;
  border: 1px solid #E5E5EA;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.2s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>