---
// Layout principal - wrapper para todas as páginas
const siteName = import.meta.env.SITE_NAME || 'Dinâmicos';
const pageTitle = Astro.props.title;
---

<!DOCTYPE html>
<html lang="pt-BR" prefix="og: https://schema.org/">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {pageTitle ? (
    <title>{pageTitle}</title>
  ) : (
    <title>{siteName} - Presença digital inteligente</title>
  )}
  
  <!-- SEO Meta -->
  <meta name="description" content={Astro.props.description || 'Site institucional B2B otimizado para SEO e agentes de IA'}>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <link rel="stylesheet" href="/src/styles/global.css">
  
  <!-- AI Engine Optimization -->
  {Astro.props.schema && Astro.props.schema}
  {Astro.props.openGraph && (
    <meta property="og:title" content={Astro.props.openGraph.title}>
    <meta property="og:description" content={Astro.props.openGraph.description}>
    <meta property="og:type" content={Astro.props.openGraph.type}>
    <meta property="og:url" content={Astro.props.openGraph.url}>
    <meta property="og:image" content={Astro.props.openGraph.image}>
  )}
  {Astro.props.twitter && (
    <meta name="twitter:card" content={Astro.props.twitter.card}>
    <meta name="twitter:title" content={Astro.props.twitter.title}>
    <meta name="twitter:description" content={Astro.props.twitter.description}>
  )}
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body class="font-sans antialiased">
  <!-- Header -->
  <header class="header">
    <div class="container mx-auto px-4 lg:px-8">
      <a href="/" class="logo text-2xl font-bold text-dark">
        Dinâmicos
      </a>
      <nav class="nav hidden sm:flex items-center space-x-8">
        <a href="/" class="nav-link">Início</a>
        <a href="/servicos" class="nav-link">Serviços</a>
        <a href="/sobre" class="nav-link">Sobre</a>
        <a href="/blog" class="nav-link">Blog</a>
        <a href="/contato" class="nav-link">Contato</a>
      </nav>
      <a href="/contato" class="btn btn-primary hidden sm:inline-flex items-center">
        Contato
      </a>
      <button class="mobile-menu-btn sm:hidden" aria-label="Abrir menu">
        <span class="block w-6 h-0.5 bg-dark"></span>
        <span class="block w-6 h-0.5 bg-dark mt-2"></span>
        <span class="block w-6 h-0.5 bg-dark mt-2"></span>
      </button>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container mx-auto px-4 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h3 class="font-bold text-lg mb-4">Dinâmicos</h3>
          <p class="text-sm text-medium">Presença digital inteligente para empresas portuguesas.</p>
        </div>
        <div>
          <h4 class="font-medium mb-4">Serviços</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/servicos" class="text-medium hover:text-primary">Serviços</a></li>
            <li><a href="/sobre" class="text-medium hover:text-primary">Sobre</a></li>
            <li><a href="/blog" class="text-medium hover:text-primary">Blog</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-medium mb-4">Empresa</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/sobre" class="text-medium hover:text-primary">Sobre nós</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-medium mb-4">Contato</h4>
          <p class="text-sm text-medium">info@dinamicos.pt</p>
          <p class="text-sm text-medium">+351 900 000 000</p>
        </div>
      </div>
      <div class="border-t border-light mt-12 pt-8 text-center text-sm text-medium">
        <p>&copy; <span id="year"></span> Dinâmicos. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>

<style>
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --color-primary: #0052FF;
  --color-primary-hover: #0042E6;
  --color-dark: #1C1C1E;
  --color-medium: #636366;
  --color-light: #E5E5EA;
  --color-bg: #FFFFFF;
  --color-bg-secondary: #F2F2F7;
}

.font-sans {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: 9999px;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--color-primary);
  color: white;
}

.btn-primary:hover {
  background-color: var(--color-primary-hover);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 82, 255, 0.15);
}

.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
}

.btn-secondary:hover {
  background-color: var(--color-primary);
  color: white;
}

.text-primary { color: var(--color-primary); }
.text-dark { color: var(--color-dark); }
.text-medium { color: var(--color-medium); }
.text-light { color: var(--color-light); }
.bg-primary { background-color: var(--color-primary); }
.bg-dark { background-color: var(--color-dark); }
.bg-light { background-color: var(--color-light); }

.header {
  position: sticky;
  top: 0;
  background: white;
  z-index: 50;
  border-bottom: 1px solid var(--color-light);
}

.footer {
  background-color: var(--color-dark);
  color: var(--color-light);
}

.footer a {
  color: var(--color-light);
  transition: color 0.2s;
}

.footer a:hover {
  color: var(--color-primary);
}

.section {
  padding: 4rem 0;
}

.section-title {
  font-size: clamp(2rem, 4vw, 2.5rem);
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  margin-bottom: 2rem;
}

.card {
  background: white;
  border: 1px solid #E5E5EA;
  border-radius: 12px;
  padding: 2rem;
  transition: all 0.2s ease;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.divider {
  position: relative;
  text-align: center;
  color: #636366;
  font-size: 14px;
}

Divider::before,
Divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 50%;
  height: 1px;
  background-color: #E5E5EA;
}

Divider::before {
  left: 0;
}

Divider::after {
  right: 0;
}
</style>