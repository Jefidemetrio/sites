---
// Component: Hero Section - Homepage
export interface HeroProps {
  title?: string;
  subtitle?: string;
  primaryCta?: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  backgroundImage?: string;
}
---

<section class="hero-section" style="background-image: url({Astro.props.backgroundImage || '/images/hero-bg.webp'});">
  <div class="container">
    <h1 class="hero-title">{Astro.props.title || 'Presença digital inteligente'}</h1>
    <p class="hero-subtitle">{Astro.props.subtitle || 'Para empresas portuguesas que querem ser encontradas'}</p>
    <div class="hero-actions">
      <a href={Astro.props.primaryCta?.href || '/contato'} class="btn btn-primary">{Astro.props.primaryCta?.text || 'Começar agora'}</a>
      <a href={Astro.props.secondaryCta?.href || '/sobre'} class="btn btn-secondary">{Astro.props.secondaryCta?.text || 'Saber mais'}</a>
    </div>
  </div>
</section>

<style>
.hero-section {
  padding: 5rem 0;
  text-align: center;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
}

.hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.85) 100%);
  z-index: 0;
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  font-size: 1.25rem;
  color: #636366;
  max-width: 600px;
  margin: 0 auto 2rem;
  position: relative;
  z-index: 1;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
}

@media (max-width: 768px) {
  .hero-section {
    padding: 3rem 1rem;
  }
  
  .hero-actions {
    flex-direction: column;
    gap: 0.75rem;
  }
}
</style>