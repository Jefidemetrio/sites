# === Directus CMS (Editor gerencia o conteúdo) ===
DIRECTUS_URL=https://directus.seudominio.com
# Token com escopo de leitura pública (usado no build/CI)
DIRECTUS_READ_TOKEN=coloqu…quio
# Token do editor (NUNCA commitar — apenas .env local)
DIRECTUS_EDITOR_TOKEN=coloqu…quio

# === Site ===
SITE_URL=https://seudominio.com
SITE_ENV=development

# === GitHub CI (configurar nos secrets do repo, não aqui) ===
# DIRECTUS_URL, DIRECTUS_READ_TOKEN → GitHub Settings > Secrets and variables > Actions
