{
  "name": "tinyhouse-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TinyHouses Portugal — site estático com conteúdo via Directus CMS",
  "scripts": {
    "fetch:content": "node scripts/fetch-directus.js",
    "build": "npm run fetch:content && node scripts/build.js",
